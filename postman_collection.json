    {
      "name": "8. Protected Payments, Orchestration, Evidence & Release (M05, M06, M10)",
      "item": [
        {
          "name": "Create Direct Protected Payment Agreement",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Accept", "value": "application/json" },
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{auth_token}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"merchant_id\": 2,\n  \"principal_amount_minor\": 20000000,\n  \"title\": \"Samsung Galaxy S23 Ultra\",\n  \"item_description\": \"256GB Phantom Black with original charger\",\n  \"delivery_method\": \"IN_PERSON_OTP\"\n}"
            },
            "url": { "raw": "{{base_url}}/protected-payments", "host": ["{{base_url}}"], "path": ["protected-payments"] }
          }
        },
        {
          "name": "Initiate Idempotent Payment Intent (M05)",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Accept", "value": "application/json" },
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Idempotency-Key", "value": "idem-pay-001" },
              { "key": "Authorization", "value": "Bearer {{auth_token}}" }
